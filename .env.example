# Auth.js — genera con: openssl rand -base64 32
AUTH_SECRET=""
# En Vercel suele bastar AUTH_TRUST_HOST=true
AUTH_TRUST_HOST="true"
# URL pública de la app (local: http://localhost:3000)
AUTH_URL="your-app-url.com"
# AUTH_URL="https://hourlysjobtime.vercel.app"

# Google OAuth (Google Cloud Console → Credenciales → OAuth 2.0)
# Redirect URI: {AUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
NODE_ENV="development"

# PostgreSQL local (docker compose). No uses aquí la DB de producción.
DATABASE_URL="postgresql://your-username:your-password@localhost:5432/your-database?schema=public"
