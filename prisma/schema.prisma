generator client {
  provider = "prisma-client-js"
  output   = "/app/generated/prisma-client"
}

datasource db {
  provider = "postgresql"
}

model Entry {
  date     String  @id
  category String
  normal   Float   @default(0)
  extra    Float   @default(0)
  festiva  Float   @default(0)
  nocturna Float   @default(0)
}

model Settings {
  id   Int   @id
  json Json
}
